[
  {
    "why": "A blank query, or one with no letters or digits, shows everything in its original order",
    "query": "  - ",
    "names": ["Squat", "Bench Press", "Deadlift"],
    "expected": ["Squat", "Bench Press", "Deadlift"]
  },
  {
    "why": "Case-insensitive",
    "query": "SQUAT",
    "names": ["Back Squat", "Bench Press"],
    "expected": ["Back Squat"]
  },
  {
    "why": "Accent-insensitive in both directions",
    "query": "agach",
    "names": ["Agachamento", "Flexão"],
    "expected": ["Agachamento"]
  },
  {
    "why": "An accent typed in the query still finds the plain name",
    "query": "flexão",
    "names": ["Flexao de braco", "Prancha"],
    "expected": ["Flexao de braco"]
  },
  {
    "why": "Words match in any order",
    "query": "press db",
    "names": ["DB Floor Press", "Bench Press", "DB Row"],
    "expected": ["DB Floor Press"]
  },
  {
    "why": "Every word has to match",
    "query": "bench squat",
    "names": ["Bench Press", "Back Squat"],
    "expected": []
  },
  {
    "why": "Punctuation separates words the same way on both sides",
    "query": "push up",
    "names": ["Push-up", "Pull-up"],
    "expected": ["Push-up"]
  },
  {
    "why": "A word start ranks above a match inside a word, original order kept within a tier",
    "query": "press",
    "names": ["Overpressure Drill", "Bench Press", "Press-up"],
    "expected": ["Bench Press", "Press-up", "Overpressure Drill"]
  },
  {
    "why": "A swap of two letters is one typo",
    "query": "bulgarain",
    "names": ["Bulgarian Split Squat", "Goblet Squat"],
    "expected": ["Bulgarian Split Squat"]
  },
  {
    "why": "A dropped letter is one typo",
    "query": "bulgaian",
    "names": ["Bulgarian Split Squat"],
    "expected": ["Bulgarian Split Squat"]
  },
  {
    "why": "A typo is forgiven against a prefix, mid-word",
    "query": "bulgr",
    "names": ["Bulgarian Split Squat", "Burpee"],
    "expected": ["Bulgarian Split Squat"]
  },
  {
    "why": "Two typos in one word are too many",
    "query": "bulgrain",
    "names": ["Bulgarian Split Squat"],
    "expected": []
  },
  {
    "why": "No typo tolerance below four characters",
    "query": "rpw",
