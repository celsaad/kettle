{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "entry": [
    // Run by hand once per release (see its header); nothing imports it.
    "store/build-assets.js",
    // Nothing in RN imports it since routing moved native (#309), but it holds theme.json's contrast
    // notes, which JSON can't, and AGENTS.md sends a new color here. M7 decides where they live.
    "src/constants/theme.ts",
  ],
  // An export its own file also uses is a named part of a public shape — the per-type configs that
  // make up the domain union, the chart layout's point types — and un-exporting them buys nothing.
  // What this still catches is an export nothing uses at all, which is the dead code worth deleting.
  "ignoreExportsUsedInFile": true,
  // The Kotlin app has no JavaScript of its own; what knip finds there is Gradle's test-report output.
  "ignore": ["native/**"],
  "ignoreDependencies": [
    // knip's expo plugin assumes EAS Update unless app.json sets `updates.enabled: false`. It is
    // absent on purpose: nothing may phone home.
    "expo-updates",
    // store/build-assets.js loads these from NODE_PATH, deliberately outside the project (see its header).
    "sharp",
    "playwright",
    // Native's `:theme` copies the faces `theme.json` names out of these packages (app/build.gradle.kts),
    // and nothing in JS loads them since #309.
    "@expo-google-fonts/hanken-grotesk",
    "@expo-google-fonts/space-grotesk",
  ],
}
