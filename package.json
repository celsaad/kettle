{
  "name": "kettle",
  "version": "1.0.0",
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "i18next": "^26.3.6",
    "js-yaml": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "babel-jest": "~29.7.0",
    "jest": "~29.7.0",
    "knip": "^6.35.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "conformance:update": "node scripts/update-conformance.mjs",
    "schema:update": "node scripts/update-library-schema.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup-after-env.js"
    ],
    "clearMocks": true,
    "restoreMocks": true,
    "transform": {
      "\\.[jt]s$": "babel-jest",
      "\\.ya?ml$": "<rootDir>/jest.text-transform.js"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "cacheDirectory": "<rootDir>/.jest-cache"
  },
  "private": true
}
