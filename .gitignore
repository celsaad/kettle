# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Jest's transform cache. Pinned to the repo rather than left in the OS temp dir so CI can restore
# it between runs; see the cache step in .github/workflows/ci.yml.
.jest-cache/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Play Console assets, regenerated by store/build-assets.js from sources already in the repo
store/out/

# Agents' git worktrees: other branches checked out locally, never part of this one.
.claude/worktrees/
