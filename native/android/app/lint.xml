<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!--
      The launcher, splash and notification icons are the files the RN app's build generated, kept as
      they were, so the app looks as it always has. They are the artwork's only source now: a change to
      it is made in res/, at every density.
    -->
    <issue id="IconLauncherShape" severity="ignore" />
    <issue id="IconDuplicates" severity="ignore" />

    <!--
      targetSdk follows the RN app's (Expo SDK 57's), which the shell must not run ahead of while it
      hosts it: they move together with an SDK bump. The check also depends on the newest platform the
      machine has installed, so it passed locally and failed on CI's newer image. Remove this once
      React Native is gone (docs/native-migration-plan.md, M7).
    -->
    <issue id="OldTargetApi" severity="ignore" />
</lint>
