  {
    "why": "A typo match ranks below a clean one",
    "query": "squat",
    "names": ["Sqaut Jump", "Back Squat"],
    "expected": ["Back Squat", "Sqaut Jump"]
  },
  {
    "why": "The worst word decides the rank, not the sum: two inside-word matches beat a word start plus a typo",
