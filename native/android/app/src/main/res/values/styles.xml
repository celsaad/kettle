<?xml version="1.0" encoding="utf-8"?>
<!--
  AppTheme is the window's theme once the splash goes. A platform parent rather than AppCompat's
  DayNight, since the activity is a plain ComponentActivity and Compose draws everything:
  Base.AppTheme is the light parent here and the dark one in values-night, so the window behind the
  first frame follows the system scheme. Edge to edge is MainActivity's (`enableEdgeToEdge`).
-->
<resources>
    <style name="Base.AppTheme" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="AppTheme" parent="Base.AppTheme">
        <!--
          Transparent here as well as in enableEdgeToEdge: on API 31 and 32 core-splashscreen re-applies
          the post-splash theme's bar colors as the splash exits (Impl31.applyAppSystemUiTheme), which
          would put the platform theme's grey or black bars back over edge-to-edge content.
        -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Base.Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashscreen_background</item>
        <!--
          Below API 31 the splash is this theme's own window, and with no status bar color it takes the
          platform default, which drew pink over the dark splash on API 26. 31+ draws its own splash and
          ignores this.
        -->
        <item name="android:statusBarColor">@color/splashscreen_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splashscreen_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <style name="Theme.App.SplashScreen" parent="Base.Theme.App.SplashScreen" />
</resources>
