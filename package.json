{
  "name": "kettle",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "expo": "~57.0.22",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "^4.7.2",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.3.6",
    "intl-pluralrules": "^2.0.1",
    "js-yaml": "^5.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "knip": "^6.35.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup-after-env.js"
    ],
    "clearMocks": true,
    "restoreMocks": true,
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg)"
    ],
    "moduleNameMapper": {
      ".css$": "<rootDir>/jest.style-mock.js"
    },
    "resolver": "<rootDir>/jest.resolver.js",
    "cacheDirectory": "<rootDir>/.jest-cache",
    "testTimeout": 30000
  },
  "private": true
}
