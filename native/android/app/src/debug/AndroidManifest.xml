<?xml version="1.0" encoding="utf-8"?>
<!--
  The prebuilt app's debug-only manifest, from React Native's template: Metro serves the bundle over
  plain http, which Android refuses by default, and the dev overlays draw over other apps. Neither
  reaches a release build.

  Plus NavigateReceiver and FilesChangedReceiver, adb's way to steer the RN surface and to make its
  stores re-read. DUMP is held by the shell user and by no installable app, so adb can send to them
  and nothing else on the phone can.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic"
        tools:targetApi="28">
        <receiver
            android:name="com.casco.kettle.shell.rn.NavigateReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name="com.casco.kettle.shell.rn.FilesChangedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
