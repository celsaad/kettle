{
  "expo": {
    "name": "kettle",
    "slug": "kettle",
    "version": "0.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kettle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.casco.kettle",
      "buildNumber": "11",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.casco.kettle",
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#c05c2b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.MODIFY_AUDIO_SETTINGS"],
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW", "android.permission.READ_APP_BADGE"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17140d",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#c05c2b"
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "pt", "ja"]
          }
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b82010cb-de56-4555-b556-532cc307badf"
      }
    },
    "owner": "celsaad"
  }
}
