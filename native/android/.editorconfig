root = true

[*.{kt,kts}]
# detekt's MaxLineLength default. ktlint_official would otherwise wrap at 140, and the two tools
# would disagree about the same line.
max_line_length = 120
# A composable is named like the UI it emits; detekt.yml makes the same exception.
ktlint_function_naming_ignore_when_annotated_with = Composable
