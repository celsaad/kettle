<?xml version="1.0" encoding="utf-8"?>
<!--
  The debug build's receivers: NavigateReceiver, adb's way to steer the shell's navigator, and
  RunnerCommandReceiver, session-check's way to drive a running session (#315). DUMP is held by the shell user and by no
  installable app, so adb can send to them and nothing else on the phone can.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="com.casco.kettle.shell.nav.NavigateReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name="com.casco.kettle.shell.runner.RunnerCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
