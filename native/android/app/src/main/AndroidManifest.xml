<?xml version="1.0" encoding="utf-8"?>
<!--
  What the prebuilt app's manifest says, which config plugins wrote into android/app and so never
  reach the AAR (an M0 build fact). The inventory is in the commit that added this. Merged, it matches
  the prebuilt app's release manifest except for the entry point, which is this shell's activity, and
  what the shell's own code needs that app.json has no source for: the notification and reminder
  permissions, the runner's foreground service and its four (#308), the reminder's receivers and the
  export provider.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <!--
      The rest-day reminder's (#236), and POST_NOTIFICATIONS the runner's too. Declared here, where
      expo-notifications' manifest once merged them in, so they outlived it (#308).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      The runner's foreground service (#305), on Play from the flip release (#308) with its Console
      declaration. `health` is the type whose documented purpose is exercise trackers (#293), and
      HIGH_SAMPLING_RATE_SENSORS is its install-time prerequisite: no prompt, and nothing reads a
      sensor. WAKE_LOCK holds the session's clock through Doze.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission
        android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"
        tools:ignore="HighSamplingRate" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:replace="android:maxSdkVersion" />
    <!-- Capped at 32, where it still means something: the prebuilt app's, kept as it was. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage"
        tools:replace="android:maxSdkVersion" />
    <!-- app.json's blockedPermissions: libraries ask for these, and the app doesn't want them. -->
    <uses-permission
        android:name="android.permission.READ_APP_BADGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!--
          Settings' backup folder (#237): whether there's a picker to choose one with. A device without
          one gets the export copy in its place, as RN gave a platform whose folder wouldn't stick.
        -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
    </queries>

    <!-- enableOnBackInvokedCallback: app.json's predictiveBackGestureEnabled: true. -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appName}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|assetsPaths|locale|layoutDirection"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App.SplashScreen"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!--
          The prebuilt app's entry point was com.casco.kettle.MainActivity, and launcher icons and
          pinned shortcuts point at that component. The alias keeps the name, so they survive the
          update to the shell.
        -->
        <activity-alias
            android:name="com.casco.kettle.MainActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kettle" />
            </intent-filter>
        </activity-alias>

        <!-- Export's share sheet (#237): read access to the one file shared, granted per share. -->
        <provider
            android:name=".export.ShellFileProvider"
            android:authorities="${applicationId}.shell.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <!-- No stopWithTask, so a Recents swipe leaves the session running (#297). -->
        <service
            android:name=".runner.RunnerService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- The rest-day reminder (#236): its alarm and its reschedule after a reboot. -->
        <receiver
            android:name=".reminder.RestDayReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminder.RestDayReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
